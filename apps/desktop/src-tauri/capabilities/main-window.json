{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window-lifecycle",
  "description": "Allow the local main window to preserve confirmed notebook state before closing.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close"
  ]
}
