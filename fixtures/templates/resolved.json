    "expected": [
      { "kind": "dot", "cx": 10, "cy": 10, "radiusPt": 0.6, "color": "#C7CDD4" },
      { "kind": "dot", "cx": 20, "cy": 10, "radiusPt": 0.6, "color": "#C7CDD4" },
      { "kind": "dot", "cx": 30, "cy": 10, "radiusPt": 0.6, "color": "#C7CDD4" },
      { "kind": "dot", "cx": 10, "cy": 20, "radiusPt": 0.6, "color": "#C7CDD4" },
      { "kind": "dot", "cx": 20, "cy": 20, "radiusPt": 0.6, "color": "#C7CDD4" },
      { "kind": "dot", "cx": 30, "cy": 20, "radiusPt": 0.6, "color": "#C7CDD4" },
      { "kind": "dot", "cx": 10, "cy": 30, "radiusPt": 0.6, "color": "#C7CDD4" },
      { "kind": "dot", "cx": 20, "cy": 30, "radiusPt": 0.6, "color": "#C7CDD4" },
      { "kind": "dot", "cx": 30, "cy": 30, "radiusPt": 0.6, "color": "#C7CDD4" }
    ]
  },
  {
    "name": "rules are measured from each page edge, not from the margin",
    "geometry": { "widthPt": 100, "heightPt": 80 },
    "template": {
      "id": "rules-test",
      "name": "Rules",
      "backgroundColor": "#FBFBF9",
      "marginPt": 10,
      "elements": [
        { "kind": "rule", "edge": "left", "offsetPt": 24, "color": "#E5645E", "weightPt": 1 },
        { "kind": "rule", "edge": "right", "offsetPt": 8, "color": "#C7CDD4", "weightPt": 0.5 },
        { "kind": "rule", "edge": "top", "offsetPt": 12, "color": "#C7CDD4", "weightPt": 0.5 },
        { "kind": "rule", "edge": "bottom", "offsetPt": 16, "color": "#C7CDD4", "weightPt": 0.5 }
      ]
    },
    "expected": [
      { "kind": "line", "x1": 24, "y1": 0, "x2": 24, "y2": 80, "color": "#E5645E", "weightPt": 1 },
      { "kind": "line", "x1": 92, "y1": 0, "x2": 92, "y2": 80, "color": "#C7CDD4", "weightPt": 0.5 },
      { "kind": "line", "x1": 0, "y1": 12, "x2": 100, "y2": 12, "color": "#C7CDD4", "weightPt": 0.5 },
      { "kind": "line", "x1": 0, "y1": 64, "x2": 100, "y2": 64, "color": "#C7CDD4", "weightPt": 0.5 }
    ]
  },
  {
    "name": "margins wider than the page leave nothing to draw",
    "geometry": { "widthPt": 40, "heightPt": 40 },
    "template": {
      "id": "cramped-test",
      "name": "Cramped",
      "backgroundColor": "#FBFBF9",
      "marginPt": 25,
      "elements": [
        { "kind": "horizontal_lines", "spacingPt": 5, "offsetPt": 0, "color": "#DDE1E6", "weightPt": 0.5 },
        { "kind": "rule", "edge": "left", "offsetPt": 4, "color": "#E5645E", "weightPt": 1 }
      ]
    },
    "expected": []
  }
]
