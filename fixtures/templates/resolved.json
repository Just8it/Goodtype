[
  {
    "name": "ruled lines step down from the top margin and include the last one on it",
    "geometry": { "widthPt": 100, "heightPt": 100 },
    "template": {
      "id": "ruled-test",
      "name": "Ruled",
      "backgroundColor": "#FBFBF9",
      "marginPt": 10,
      "elements": [
        { "kind": "horizontal_lines", "spacingPt": 20, "offsetPt": 0, "color": "#DDE1E6", "weightPt": 0.5 }
      ]
    },
    "expected": [
      { "kind": "line", "x1": 10, "y1": 10, "x2": 90, "y2": 10, "color": "#DDE1E6", "weightPt": 0.5 },
      { "kind": "line", "x1": 10, "y1": 30, "x2": 90, "y2": 30, "color": "#DDE1E6", "weightPt": 0.5 },
      { "kind": "line", "x1": 10, "y1": 50, "x2": 90, "y2": 50, "color": "#DDE1E6", "weightPt": 0.5 },
      { "kind": "line", "x1": 10, "y1": 70, "x2": 90, "y2": 70, "color": "#DDE1E6", "weightPt": 0.5 },
      { "kind": "line", "x1": 10, "y1": 90, "x2": 90, "y2": 90, "color": "#DDE1E6", "weightPt": 0.5 }
    ]
  },
  {
    "name": "an offset pushes the first line past the margin and drops the one that no longer fits",
    "geometry": { "widthPt": 100, "heightPt": 100 },
    "template": {
      "id": "offset-test",
      "name": "Offset",
      "backgroundColor": "#FBFBF9",
      "marginPt": 10,
      "elements": [
        { "kind": "horizontal_lines", "spacingPt": 30, "offsetPt": 15, "color": "#DDE1E6", "weightPt": 0.5 }
      ]
    },
    "expected": [
      { "kind": "line", "x1": 10, "y1": 25, "x2": 90, "y2": 25, "color": "#DDE1E6", "weightPt": 0.5 },
      { "kind": "line", "x1": 10, "y1": 55, "x2": 90, "y2": 55, "color": "#DDE1E6", "weightPt": 0.5 },
      { "kind": "line", "x1": 10, "y1": 85, "x2": 90, "y2": 85, "color": "#DDE1E6", "weightPt": 0.5 }
    ]
  },
  {
    "name": "squared paper is both axes of the same grid, horizontals first",
    "geometry": { "widthPt": 90, "heightPt": 70 },
    "template": {
      "id": "squared-test",
      "name": "Squared",
      "backgroundColor": "#FBFBF9",
      "marginPt": 10,
      "elements": [
        { "kind": "horizontal_lines", "spacingPt": 25, "offsetPt": 0, "color": "#DDE1E6", "weightPt": 0.4 },
        { "kind": "vertical_lines", "spacingPt": 35, "offsetPt": 0, "color": "#DDE1E6", "weightPt": 0.4 }
      ]
    },
    "expected": [
      { "kind": "line", "x1": 10, "y1": 10, "x2": 80, "y2": 10, "color": "#DDE1E6", "weightPt": 0.4 },
      { "kind": "line", "x1": 10, "y1": 35, "x2": 80, "y2": 35, "color": "#DDE1E6", "weightPt": 0.4 },
      { "kind": "line", "x1": 10, "y1": 60, "x2": 80, "y2": 60, "color": "#DDE1E6", "weightPt": 0.4 },
      { "kind": "line", "x1": 10, "y1": 10, "x2": 10, "y2": 60, "color": "#DDE1E6", "weightPt": 0.4 },
      { "kind": "line", "x1": 45, "y1": 10, "x2": 45, "y2": 60, "color": "#DDE1E6", "weightPt": 0.4 },
      { "kind": "line", "x1": 80, "y1": 10, "x2": 80, "y2": 60, "color": "#DDE1E6", "weightPt": 0.4 }
    ]
  },
  {
    "name": "a dot grid runs rows outer, columns inner",
    "geometry": { "widthPt": 40, "heightPt": 40 },
    "template": {
      "id": "dotted-test",
      "name": "Dotted",
      "backgroundColor": "#FBFBF9",
      "marginPt": 10,
      "elements": [
        { "kind": "dots", "spacingPt": 10, "offsetPt": 0, "color": "#C7CDD4", "radiusPt": 0.6 }
      ]
