  {
    "name": "a dot grid runs rows outer, columns inner",
    "geometry": { "widthPt": 40, "heightPt": 40 },
    "template": {
      "id": "dotted-test",
      "name": "Dotted",
      "backgroundColor": "#FBFBF9",
      "elements": [
        {
          "kind": "dots",
          "area": { "topPt": 10, "rightPt": 10, "bottomPt": 10, "leftPt": 10 },
          "spacingPt": 10,
          "color": "#C7CDD4",
          "radiusPt": 0.6
        }
