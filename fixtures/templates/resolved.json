  {
    "name": "rules are measured from the page edge and span their own area",
    "geometry": { "widthPt": 100, "heightPt": 80 },
    "template": {
      "id": "rules-test",
      "name": "Rules",
      "backgroundColor": "#FBFBF9",
      "elements": [
        {
          "kind": "rule",
          "area": { "topPt": 10, "rightPt": 10, "bottomPt": 20, "leftPt": 10 },
          "edge": "left",
          "offsetPt": 24,
          "color": "#E5645E",
          "weightPt": 1
        },
        {
          "kind": "rule",
          "area": { "topPt": 10, "rightPt": 10, "bottomPt": 20, "leftPt": 10 },
          "edge": "right",
          "offsetPt": 8,
          "color": "#C7CDD4",
          "weightPt": 0.5
        },
        {
          "kind": "rule",
          "area": { "topPt": 10, "rightPt": 10, "bottomPt": 20, "leftPt": 10 },
          "edge": "top",
          "offsetPt": 12,
          "color": "#C7CDD4",
          "weightPt": 0.5
        },
        {
          "kind": "rule",
          "area": { "topPt": 10, "rightPt": 10, "bottomPt": 20, "leftPt": 10 },
          "edge": "bottom",
          "offsetPt": 16,
          "color": "#C7CDD4",
          "weightPt": 0.5
        }
      ]
    },
    "expected": [
      { "kind": "line", "x1": 24, "y1": 10, "x2": 24, "y2": 60, "color": "#E5645E", "weightPt": 1 },
      { "kind": "line", "x1": 92, "y1": 10, "x2": 92, "y2": 60, "color": "#C7CDD4", "weightPt": 0.5 },
      { "kind": "line", "x1": 10, "y1": 12, "x2": 90, "y2": 12, "color": "#C7CDD4", "weightPt": 0.5 },
      { "kind": "line", "x1": 10, "y1": 64, "x2": 90, "y2": 64, "color": "#C7CDD4", "weightPt": 0.5 }
    ]
  },
