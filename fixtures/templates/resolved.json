[
  {
    "name": "ruling is centred in its area, so the gap at each edge is the same",
    "geometry": { "widthPt": 100, "heightPt": 100 },
    "template": {
      "id": "ruled-test",
      "name": "Ruled",
      "backgroundColor": "#FBFBF9",
      "elements": [
        {
          "kind": "horizontal_lines",
          "area": { "topPt": 10, "rightPt": 10, "bottomPt": 10, "leftPt": 10 },
          "spacingPt": 25,
          "color": "#DDE1E6",
          "weightPt": 0.5
        }
      ]
    },
    "expected": [
      { "kind": "line", "x1": 10, "y1": 25, "x2": 90, "y2": 25, "color": "#DDE1E6", "weightPt": 0.5 },
      { "kind": "line", "x1": 10, "y1": 50, "x2": 90, "y2": 50, "color": "#DDE1E6", "weightPt": 0.5 },
      { "kind": "line", "x1": 10, "y1": 75, "x2": 90, "y2": 75, "color": "#DDE1E6", "weightPt": 0.5 }
    ]
  },
